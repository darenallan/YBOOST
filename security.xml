<file path="src/middleware/validationMiddleware.js">
const validator = require("validator")
const xss = require("xss")

const validationMiddleware = (req, res, next) => {

    // On récupère les données
    const body = req.body

    if (!body) {
        return res.status(400).json({
            message: "No data provided"
        })
    }

    // Nettoyage XSS sur chaque champ
    for (let key in body) {
        if (typeof body[key] === "string") {
            body[key] = xss(body[key])
        }
    }

    // Validation email si présent
    if (body.email) {
        if (!validator.isEmail(body.email)) {
            return res.status(400).json({
                message: "Invalid email format"
            })
        }
    }

    // Validation mot de passe si présent
    if (body.password) {
        if (!validator.isLength(body.password, { min: 6 })) {
            return res.status(400).json({
                message: "Password must be at least 6 characters"
            })
        }
    }

    next()
}

module.exports = validationMiddleware
</file>


<file path="src/services/security/aiSecurity.js">
const xss = require("xss")
const validator = require("validator")

const aiSecurity = (message) => {

    if (!message) {
        return {
            valid: false,
            error: "Empty message"
        }
    }

    // limiter taille message
    if (message.length > 500) {
        return {
            valid: false,
            error: "Message too long"
        }
    }

    // nettoyage XSS
    let cleanMessage = xss(message)

    // suppression caractères dangereux
    cleanMessage = validator.escape(cleanMessage)

    return {
        valid: true,
        message: cleanMessage
    }
}

module.exports = aiSecurity
</file>

<file path="src/sockets/socketAuth.js">
const jwt = require("jsonwebtoken")

const socketAuth = (socket, next) => {

    try {

        // récupérer token envoyé par le frontend
        const token = socket.handshake.auth?.token

        if (!token) {
            return next(new Error("No token provided"))
        }

        // vérifier token
        const decoded = jwt.verify(token, process.env.JWT_SECRET)

        // attacher user au socket
        socket.user = decoded

        next()

    } catch (error) {
        return next(new Error("Unauthorized socket connection"))
    }
}

module.exports = socketAuth
</file>

<file path="src/utils/generateToken.js">
const jwt = require("jsonwebtoken")

const generateToken = (userId) => {
    return jwt.sign(
        { id: userId },
        process.env.JWT_SECRET,
        { expiresIn: "7d" }
    )
}

module.exports = generateToken
</file>

<file path="src/utils/hashPassword.js">
const bcrypt = require("bcrypt")

const hashPassword = async (password) => {
    const salt = await bcrypt.genSalt(10)
    return await bcrypt.hash(password, salt)
}

module.exports = hashPassword
